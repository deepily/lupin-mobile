# Claude Code local settings (keep slash commands tracked)
.claude/*
!.claude/commands/

# Backup local exclusions (per-machine overrides)
src/scripts/conf/rsync-exclude-local.txt

# Private project configuration
CLAUDE.local.md

# IDE and editor files
.vscode/
.idea/
*.iml
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
logs/

# Runtime data
pids
*.pid
*.seed

# Temporary files
tmp/
temp/

# Build outputs (to be updated based on chosen framework)
build/
dist/
out/

# Dependencies (to be updated based on chosen framework)
node_modules/
.packages
pubspec.lock

# Environment files
.env
.env.local
.env.*.local

# Python virtual environment
.venv/
venv/

# Local Flutter installation
flutter/
.flutter/

# Auto-generated Flutter env file (machine-specific paths)
ios/Flutter/flutter_export_environment.sh

# Flutter auto-generated build artifacts (machine-specific, regenerated by `flutter pub get`)
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
ios/Runner/GeneratedPluginRegistrant.m

# Claude Code parallel-session manifest (per ~/.claude/CLAUDE.md recommendation)
.claude-session.md

# Python bytecode
__pycache__/
*.pyc

# IDE workspace files
*.code-workspace
# Claude mementos (records + pointers) — NEVER commit: a memento that
# will be committed is written more carefully, and therefore less honestly.
io/mementos/
.claude-memento.md
.claude-memento-*.md
